apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: v{{ kube_version }}
imageRepository: "{{ registry_host }}:{{ registry_port }}"
clusterName: offline-cluster
controlPlaneEndpoint: "{{ control_plane_endpoint }}"
etcd:
  local:
    imageRepository: "{{ registry_host }}:{{ registry_port }}"
    imageTag: "{{ etcd_image_tag }}"
networking:
  podSubnet: "{{ pod_cidr }}"
  # Explicit serviceSubnet so ClusterIP allocator has a range. Must match service_network_cidr (group_vars).
  serviceSubnet: "{{ service_network_cidr | default('10.96.0.0/12') }}"

---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ ansible_default_ipv4.address | default('') }}"
nodeRegistration:
  criSocket: "/run/containerd/containerd.sock"
