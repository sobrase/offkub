# IPv6 restrict_access: established/related + lo only if disable_ipv6; else accept all.
# Generated by Ansible - do not edit by hand.
# Load: ip6tables-restore < /etc/iptables/rules.v6
*filter
:INPUT {{ 'DROP' if (restrict_access_disable_ipv6 | default(true) | bool) else 'ACCEPT' }} [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
{% if restrict_access_disable_ipv6 | default(true) | bool %}
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -p tcp -m multiport --dports 22,{{ restrict_access_ssh_port }} -j ACCEPT
-A INPUT -j DROP
{% endif %}
COMMIT
