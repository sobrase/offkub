# IPv4 restrict_access: traffic between cluster nodes (cluster_peer_ips) is fully allowed.
# From outside: SSH open to all; other ports only from allowed_source_ips.
# DOCKER chain must exist so the daemon can add rules for published container ports.
# Generated by Ansible - do not edit by hand.
# Load: iptables-restore < /etc/iptables/rules.v4
*filter
:INPUT DROP [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:DOCKER - [0:0]
:DOCKER-USER - [0:0]
-A FORWARD -j DOCKER-USER
-A FORWARD -j DOCKER
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i lo -j ACCEPT
-A INPUT -j DOCKER-USER
-A INPUT -j DOCKER
-A INPUT -p tcp -m multiport --dports 22,{{ restrict_access_ssh_port }} -j ACCEPT
{% for ip in allowed_source_ips %}
-A INPUT -s {{ ip }} -j ACCEPT
{% endfor %}
# Cluster nodes: allow all traffic from other VPS nodes (no port restriction)
{% for ip in cluster_peer_ips %}
-A INPUT -s {{ ip }} -j ACCEPT
{% endfor %}
{% if restrict_access_log_drops | default(false) | bool %}
-A INPUT -j LOG --log-prefix "ipt-drop: " --log-level 4
{% endif %}
-A INPUT -j DROP
COMMIT
