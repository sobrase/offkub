---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ nfs_storage_class.name }}
{% if nfs_storage_class.is_default %}
  annotations:
    storageclass.kubernetes.io/is-default-class: "true"
{% endif %}
provisioner: nfs.csi.k8s.io
parameters:
  server: {{ nfs_storage_class.server }}
  share: {{ nfs_storage_class.share }}
reclaimPolicy: {{ nfs_storage_class.reclaim_policy }}
volumeBindingMode: {{ nfs_storage_class.volume_binding_mode }}
allowVolumeExpansion: {{ nfs_storage_class.allow_volume_expansion | lower }}
{% if nfs_storage_class.mount_options | length > 0 %}
mountOptions:
{% for opt in nfs_storage_class.mount_options %}
  - {{ opt }}
{% endfor %}
{% endif %}
